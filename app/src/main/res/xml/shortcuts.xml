<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_expense"
        android:shortcutShortLabel="@string/shortcut_expense">
        <intent
            android:action="com.personalfinances.ADD_EXPENSE"
            android:targetPackage="${applicationId}"
            android:targetClass="com.personalfinances.ui.QuickAddActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_income">
        <intent
            android:action="com.personalfinances.ADD_INCOME"
            android:targetPackage="${applicationId}"
            android:targetClass="com.personalfinances.ui.QuickAddActivity" />
    </shortcut>
</shortcuts>
