<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de la splash: fondo morado redondeado con las barras del logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="160dp" android:height="160dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/brand" />
        </shape>
    </item>
    <item android:width="108dp" android:height="108dp" android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
